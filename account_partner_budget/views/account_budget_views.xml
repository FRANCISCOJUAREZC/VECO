<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record model="ir.ui.view" id="view_account_partner_budget_form">
        <field name="name">view.account.partner.budget.form</field>
        <field name="model">budget.analytic</field>
        <field name="inherit_id" ref="account_budget.view_budget_analytic_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='budget_line_ids']/list/field[@name='currency_id']" position="after">
                <field name="partner_id"/>
            </xpath>
        </field>
    </record>
</odoo>
