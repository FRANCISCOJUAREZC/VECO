<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
    	<record id="view_fatura_global_form" model="ir.ui.view">
            <field name="name">CFDI Traslado tree</field>
            <field name="model">cfdi.traslado</field>
            <field name="arch" type="xml">
                <form string="CFDI Traslado">
                    <header>
                        <field name="factura_cfdi" invisible="1"/>
                        <button name="action_valid" type="object" invisible="state != 'draft'" string="Validar" class="oe_highlight"/>
                        <button name="action_set_draft" type="object" invisible="state != 'cancel'" string="Cambiar a borrador" class="oe_highlight"/>
                        <button name="action_cancel" string="Cancelar" type="object" invisible="state in ['draft','cancel']"/>
                        <button name="action_cfdi_generate" type="object" string="Generar CFDI" 
                            invisible="factura_cfdi == True or state != 'valid'"
                            class="oe_highlight" groups="base.group_user"/>
                    <button name="%(l10n_mx_traslado.reason_cancelation_sat_wizard)d"
                            type="action"
                            string="Cancelar CFDI"
                            invisible="factura_cfdi == False or estado_factura in ['solicitud_cancelar', 'factura_cancelada', 'solicitud_rechazada']" 
                            class="oe_highlight"
                            groups="base.group_user"/>
                            <!--<button name="action_cfdi_rechazada"
                            type="object"
                            string="Cambiar estado CFDI a factura correcta"
                            attrs="{'invisible':['|',('factura_cfdi','=',False), ('estado_factura','not in',('solicitud_rechazada'))]}" 
                            class="oe_highlight"
                            groups="base.group_user"
                            confirm="La factura va pasar a estado correcto y puede intentar cancelar nuevamente."/>-->
                        <button name="send_factura_mail" class="oe_highlight" invisible="estado_factura == 'factura_no_generada'" string="Enviar por correo-e" type="object"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,valid,cancel" />
                    </header>
                   <sheet>
                   <div>
                    <h1 class="mt0">
                       <field name="number" class="oe_inline"/>
                    </h1>
                   </div>
                   <group>
                    <group>
                        <field name="partner_id" readonly="state == 'valid'"/>
                        <field name="source_document" readonly="state == 'valid'"/>
                    </group>
                    <group>
                        <field name="invoice_date" readonly="state == 'valid'"/>
                        <field name="tipo_transporte" readonly="state == 'valid'"/>
                        <field name="carta_porte" readonly="state == 'valid'"/>
                    </group>
                    </group>
                    <notebook>
                        <page name="invoice_line_factura" string="Mercancía a trasladar">
                            <field name="factura_line_ids" readonly="state == 'valid'">
                              <list editable="bottom">
                                <control>
                                   <create string="Agregar línea"/>
                                </control>
                                <field name="currency_id" column_invisible="True"/>
                                <field name="cfdi_traslado_id" column_invisible="True"/>
                                <field name="product_id" string="Producto"/>
                                <field name="name" string="Nombre"/>
                                <field name="quantity" string="Cantidad"/>
                                <field name="price_unit" string="Precio Unitario"/>
                                <field name="pesoenkg"/>
                                <field name="invoice_line_tax_ids" widget="many2many_tags" column_invisible="True"/>
                                <field name="moneda"/>
                                <field name="price_subtotal" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                <field name="guias_line_ids" widget="many2many_tags" column_invisible="parent.manejodeguias != True" domain="[('cfdi_traslado_id','=',cfdi_traslado_id)]"/>
                                <field name="aduanera_line_ids" widget="many2many_tags" column_invisible="parent.transpinternac != 'Sí'" domain="[('cfdi_traslado_id','=',cfdi_traslado_id)]"/>
                                <field name="transporta_line_ids" widget="many2many_tags" column_invisible="parent.manejodeids != True" domain="[('cfdi_traslado_id','=',cfdi_traslado_id)]"/>
                              </list>
                            </field>
                            <group class="oe_subtotal_footer oe_right">
                                <field name="currency_id" invisible="1"/>
                                <field name="amount_untaxed" string="Subtotal"/>
                                <field name="amount_tax" invisible="1"/>
                                <field name="amount_total" class="oe_subtotal_footer_separator" widget="monetary" options="{'currency_field': 'currency_id'}" string="Total"/>
                            </group>
                            <field name="aduanera_line_ids" readonly="state == 'valid'" invisible="transpinternac != 'Sí'">
                              <list editable="bottom">
                                <control>
                                   <create string="Agregar línea"/>
                                </control>
                                <field name="tipo_documento_id" />
                                <field name="pedimento" />
                                <field name="id_doc_aduanero" />
                                <field name="rfc_import" />
                              </list>
                            </field>
                            <field name="guias_line_ids" readonly="state == 'valid'" invisible="manejodeguias != True">
                              <list editable="bottom">
                                <control>
                                   <create string="Agregar línea"/>
                                </control>
                                <field name="guiaid_numero" />
                                <field name="guiaid_descrip" />
                                <field name="guiaid_peso" />
                              </list>
                            </field>
                            <field name="transporta_line_ids" readonly="estado_factura != 'factura_no_generada'" invisible="manejodeids != True">
                              <list editable="bottom">
                                <control>
                                   <create string="Agregar línea"/>
                                </control>
                                <field name="name"/>
                                <field name="cantidad"/>
                                <field name="idorigen"/>
                                <field name="iddestino"/>
                              </list>
                            </field>
                            <field name="comment" placeholder="Términos y condiciones..."/>
                        </page>
                        <page name="info_adicional" string="Información Adicional">
                            <group cols="4">
                                <group string="Detalles de Pago">
                                    <field name="company_id" readonly="state == 'valid'"/>
                                    <field name="journal_id" readonly="state == 'valid'"/>
                                   <!--<field name="pricelist_id"/>-->
                                    <field name="currency_id" string="Moneda" readonly="state == 'valid'"/>
                                </group>
                            </group>
                        </page>
                        <page name="info_cdfi" string="CFDI">
                            <group cols="4">
                                <group string="Detalles de Pago">
                                    <field name="forma_pago" invisible="1" readonly="state == 'valid'"/>
                                    <field name="methodo_pago" invisible="1" readonly="state == 'valid'"/>
                                    <field name="uso_cfdi" readonly="True"/>
                                </group>
                                <group  string="Detalles de Factura">
                                    <field name="tipo_comprobante" readonly="True" default="T"/>
                                    <field name="folio_fiscal" readonly="True"/>
                                    <field name="confirmacion" readonly="state == 'valid'"/>
                                    <field name="estado_factura"/>
                                    <field name="fecha_factura" readonly="state == 'valid'"/>
                                </group>
                                <group  string="CFDI Relacionados">
                                    <field name="tipo_relacion" readonly="state == 'valid'"/>
                                    <field name="uuid_relacionado" readonly="state == 'valid'"/>
                                </group>
                            </group>
                        </page>

                        <page name="carta_porte" string="Carta Porte" invisible="carta_porte == False">
                            <group cols="4">
                                <group string="Atributos de carta porte">
                                    <field name="transpinternac" readonly="state == 'valid'"/>
                                    <field name="entradasalidamerc" readonly="state == 'valid'" invisible="transpinternac != 'Sí'"/>
                                    <field name="viaentradasalida" readonly="state == 'valid'" invisible="transpinternac != 'Sí'"/>
                                    <field name="uuidcomercioext" readonly="state == 'valid'" invisible="transpinternac != 'Sí' or entradasalidamerc != 'salida'"/>
                                    <field name="paisorigendestino" readonly="state == 'valid'" invisible="transpinternac != 'Sí'"/>
                                    <field name="IdCCP"/>
                                    <field name="LogisticaInversa" readonly="state == 'valid'"/>
                                </group>
                                <group string="Atributos de mercancias">
                                    <field name="pesobrutototal" readonly="state == 'valid'"/>
                                    <field name="unidadpeso" readonly="state == 'valid'"/>
                                    <field name="pesonetototal" readonly="state == 'valid'"/>
                                    <field name="numerototalmercancias" readonly="state == 'valid'"/>
                                    <field name="manejodeguias" readonly="state == 'valid'"/>
                                    <field name="manejodeids" readonly="state == 'valid'"/>
                                </group>
                                <group invisible="transpinternac != 'Sí'">
                                       <field name="aduanero_line_ids" readonly="state == 'valid'">
                                           <list editable="bottom">
                                               <control>
                                                  <create string="Agregar línea"/>
                                               </control>
                                              <field name="regimen_aduanero"/>
                                           </list>
                                       </field>
                                </group>
                            </group>
                        </page>

                        <page name="ccp_ubicaciones" string="Ubicaciones" invisible="carta_porte == False">
                          <field name="ubicaciones_line_ids" readonly="state == 'valid'" context="{'default_tipo_transporte' : tipo_transporte}">
                            <list editable="bottom">
                                <control>
                                    <create string="Agregar línea"/>
                                </control>
                                <field name="tipo_transporte" column_invisible="1"/>
                                <field name="tipoubicacion"/>
                                <field name="contacto"/>
                                <field name="fecha"/>
                                <field name="idubicacion" column_invisible="parent.manejodeids != True"/>
                                <field name="tipoestacion" column_invisible="parent.tipo_transporte == '01'"/>
                                <field name="numestacion" column_invisible="parent.tipo_transporte == '01'"/>
                                <field name="distanciarecorrida" column_invisible="parent.tipo_transporte != '01'"/>
                            </list>
                          </field>
                        </page>

                        <page name="ccp_autotransporte" string="Datos de transporte" invisible="carta_porte == False">
                            <group cols="4">
                                <group string="Generales">
                                    <field name="permisosct" readonly="state == 'valid'"/>
                                    <field name="numpermisosct" readonly="state == 'valid'"/>
                                </group>
                                <group>
                                </group>
                                <group string="Autotransporte" invisible="tipo_transporte != '01'">
                                    <field name="autotrasporte_ids" readonly="state == 'valid'"/>
                                </group>
                                <group invisible="tipo_transporte != '01'">
                                    <field name="remolque_line_ids" readonly="state == 'valid'">
                                        <list editable="bottom">
                                           <control>
                                              <create string="Agregar línea"/>
                                           </control>
                                           <field name="subtipo_id" />
                                           <field name="placa" />
                                        </list>
                                    </field>
                                </group>
                                <group string="Seguro de mercancías" invisible="tipo_transporte != '01'">
                                    <field name="nombreaseg_merc" readonly="state == 'valid'"/>
                                    <field name="numpoliza_merc" readonly="state == 'valid'"/>
                                    <field name="primaseguro_merc" readonly="state == 'valid'"/>
                                </group>
                                <group string="Seguro medioambiental" invisible="tipo_transporte != '01'">
                                    <field name="seguro_ambiente" readonly="state == 'valid'"/>
                                    <field name="poliza_ambiente" readonly="state == 'valid'"/>
                                </group>
                                <group string="Aereo" invisible="tipo_transporte != '03'">
                                    <field name="numeroguia" readonly="state == 'valid'"/>
                                    <field name="lugarcontrato" readonly="state == 'valid'"/>
                                    <field name="transportista_id" readonly="state == 'valid'"/>
                                    <field name="embarcador_id" readonly="state == 'valid'"/>
                                    <field name="matriculaaeronave" readonly="state == 'valid'"/>
                                    <field name="cargoportasacion" readonly="state == 'valid'"/>
                                </group>
                            </group>
                        </page>
                        <page name="ccp_figuratrans" string="Figura transporte" invisible="carta_porte == False">
                                <group string="Figura transporte">
                                    <field name="figuratransporte_ids" readonly="state == 'valid'">
                                        <list editable="bottom">
                                            <control>
                                               <create string="Agregar línea"/>
                                            </control>
                                           <field name="tipofigura" />
                                           <field name="figura_id" />
                                           <field name="partetransporte" widget="many2many_tags"/>
                                        </list>
                                    </field>
                                </group>
                        </page>
                    </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="view_fatura_global_tree" model="ir.ui.view">
            <field name="name">CFDI Traslado tree</field>
            <field name="model">cfdi.traslado</field>
            <field name="arch" type="xml">
                <list string="CFDI Traslado" default_order="invoice_date desc">
                    <field name="currency_id" column_invisible="True"/>
                    <field name="partner_id"/>
                    <field name="invoice_date"/>
                    <field name="number"/>
                    <field name="source_document"/>
                    <field name="amount_total" sum="amount total" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                    <field name="estado_factura"/>
                    <field name="state"/>
                </list>
            </field>
        </record>

        <record id="action_fatura_global_tree" model="ir.actions.act_window">
            <field name="name">CFDI Traslado</field>
            <field name="res_model">cfdi.traslado</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="view_fatura_global_tree"/>
        </record>

        <menuitem id="customer_sub_menu_factura_global" name="CFDI Traslado" action="action_fatura_global_tree" parent="account.menu_finance_receivables" sequence="111"/>

        <record id="model_action_llenar_ubicaciones" model="ir.actions.server">
           <field name="name">Llenar ID Ubicacion</field>
           <field name="model_id" ref="l10n_mx_traslado.model_cfdi_traslado"/>
           <field name="binding_model_id" ref="l10n_mx_traslado.model_cfdi_traslado"/>
           <field name="state">code</field>
           <field name="code">action = records.llenar_id_ubicacion()</field>
        </record>

    </data>
</odoo>
