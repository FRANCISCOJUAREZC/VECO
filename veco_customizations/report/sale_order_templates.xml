<odoo>
    <!--
        Shared layout for the VECO / DVI quotation and sale order reports.

        The Studio report copies (sale.report_saleorder_document_copy_*) only
        t-call this template, passing their own texts/flags with t-set (see
        migrations/2.0.6). Parameters:

        title           Document title printed before the number (e.g. "Cotización Filtros")
        banner          Markup: optional centered heading above the title
        quote           Quotation style: notes, seller card, "Método de envío"
                        (otherwise sale order style: PO number, agreed delivery date,
                        delivery data)
        show_shipping_method  Header "Método de envío" (x_studio_mtodo_de_envo_2024)
        work_order      Lines without prices: Código / Descripción / Observaciones / Cantidad
        show_services   Service sections (alcance, requerimientos, condiciones comerciales)
        revision        Form code printed at the bottom
    -->
    <template id="report_saleorder_veco_document">
        <t t-call="web.external_layout">
            <t t-set="doc" t-value="doc.with_context(lang=doc.partner_id.lang)"/>
            <t t-set="accent" t-value="doc.company_id.primary_color or '#0085af'"/>
            <t t-set="lines" t-value="doc.order_line.filtered(lambda l: not l.is_downpayment or l.display_type)"/>
            <t t-set="display_discount" t-value="any(l.discount for l in lines)"/>
            <t t-set="ncols" t-value="4 if work_order else (5 + (1 if display_discount else 0))"/>
            <t t-set="contact" t-value="doc.x_studio_contact_id.name or doc.x_studio_free_contact"/>
            <div class="page veco_doc">
                <t t-call="veco_customizations.report_veco_styles"/>

                <div t-if="banner" class="v-banner" t-attf-style="color: {{ accent }};"><t t-out="banner"/></div>

                <!-- Title + document info -->
                <table class="o_ignore_layout_styling v-avoid" style="margin-bottom: 12px;">
                    <tr>
                        <td style="width: 52%; vertical-align: top;">
                            <div class="v-title" t-attf-style="color: {{ accent }};"><t t-out="title"/></div>
                            <div class="v-number"><span t-field="doc.name"/></div>
                            <div t-if="doc.state == 'cancel'" class="v-subtitle text-danger">CANCELADO</div>
                        </td>
                        <td class="v-box" style="width: 48%;">
                            <table class="o_ignore_layout_styling v-info">
                                <tr>
                                    <td class="v-k"><t t-if="quote">Fecha de cotización</t><t t-else="">Fecha de pedido</t></td>
                                    <td><span t-field="doc.date_order" t-options="{'widget': 'date'}"/></td>
                                </tr>
                                <tr t-if="quote and doc.validity_date and doc.state in ('draft', 'sent')">
                                    <td class="v-k">Válida hasta</td>
                                    <td><span t-field="doc.validity_date"/></td>
                                </tr>
                                <tr t-if="doc.user_id">
                                    <td class="v-k">Vendedor</td>
                                    <td><span t-field="doc.user_id"/></td>
                                </tr>
                                <tr t-if="doc.payment_term_id">
                                    <td class="v-k">Términos de pago</td>
                                    <td><span t-field="doc.payment_term_id"/></td>
                                </tr>
                                <tr t-if="not quote and doc.x_studio_metodo_de_pago">
                                    <td class="v-k">Condiciones de pago</td>
                                    <td><span t-field="doc.x_studio_metodo_de_pago"/></td>
                                </tr>
                                <tr t-if="not quote and doc.x_studio_no_de_oc">
                                    <td class="v-k">No. OC</td>
                                    <td><span t-field="doc.x_studio_no_de_oc"/></td>
                                </tr>
                                <tr t-if="doc.client_order_ref">
                                    <td class="v-k">Su referencia</td>
                                    <td><span t-field="doc.client_order_ref"/></td>
                                </tr>
                                <tr t-if="not quote and doc.commitment_date">
                                    <td class="v-k">Fecha acordada de entrega</td>
                                    <td><span t-field="doc.commitment_date" t-options="{'widget': 'date'}"/></td>
                                </tr>
                                <tr t-if="show_shipping_method and doc.x_studio_mtodo_de_envo_2024">
                                    <td class="v-k">Método de envío</td>
                                    <td><span t-field="doc.x_studio_mtodo_de_envo_2024"/></td>
                                </tr>
                                <tr t-if="doc.incoterm">
                                    <td class="v-k">Incoterm</td>
                                    <td><span t-field="doc.incoterm.code"/></td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                </table>

                <!-- Parties -->
                <table class="o_ignore_layout_styling v-avoid" style="margin-bottom: 14px;">
                    <tr>
                        <td style="width: 33%;" class="v-box-title" t-attf-style="background: {{ accent }};">Cliente</td>
                        <td class="v-gap"/>
                        <td style="width: 33%;" class="v-box-title" t-attf-style="background: {{ accent }};">Facturar a</td>
                        <td class="v-gap"/>
                        <td style="width: 33%;" class="v-box-title" t-attf-style="background: {{ accent }};">Entregar en</td>
                    </tr>
                    <tr>
                        <td class="v-box" style="border-top: 0 !important;">
                            <div t-field="doc.partner_id" t-options="{'widget': 'contact', 'fields': ['name', 'address', 'phone', 'email'], 'no_marker': True, 'phone_icons': True}"/>
                            <div t-if="contact" class="mt-1"><strong>Contacto:</strong> <t t-out="contact"/></div>
                        </td>
                        <td class="v-gap"/>
                        <td class="v-box" style="border-top: 0 !important;">
                            <div t-field="doc.partner_invoice_id" t-options="{'widget': 'contact', 'fields': ['name', 'address'], 'no_marker': True}"/>
                            <div t-if="doc.partner_invoice_id.vat" class="mt-1"><strong>RFC:</strong> <span t-field="doc.partner_invoice_id.vat"/></div>
                        </td>
                        <td class="v-gap"/>
                        <td class="v-box" style="border-top: 0 !important;">
                            <div t-field="doc.partner_shipping_id" t-options="{'widget': 'contact', 'fields': ['name', 'address', 'phone'], 'no_marker': True, 'phone_icons': True}"/>
                        </td>
                    </tr>
                </table>

                <!-- Lines -->
                <table class="o_ignore_layout_styling v-lines">
                    <thead style="display: table-row-group;">
                        <tr t-attf-style="background: {{ accent }};">
                            <t t-if="work_order">
                                <th class="text-start" style="width: 14%;">Código</th>
                                <th class="text-start">Descripción</th>
                                <th class="text-start" style="width: 32%;">Observaciones</th>
                                <th class="text-end" style="width: 12%;">Cantidad</th>
                            </t>
                            <t t-else="">
                                <th class="text-start">Descripción</th>
                                <th class="text-end" style="width: 12%;">Cantidad</th>
                                <th class="text-end" style="width: 13%;">Precio unit.</th>
                                <th t-if="display_discount" class="text-end" style="width: 9%;">Desc. %</th>
                                <th class="text-end" style="width: 9%;">Impuestos</th>
                                <th class="text-end" style="width: 14%;">Importe</th>
                            </t>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="lines" t-as="line">
                            <tr t-if="line.display_type == 'line_section'" class="v-section">
                                <td t-att-colspan="ncols"><span t-field="line.name"/></td>
                            </tr>
                            <tr t-elif="line.display_type == 'line_note'" class="v-note">
                                <td t-att-colspan="ncols"><span t-field="line.name"/></td>
                            </tr>
                            <tr t-elif="work_order">
                                <td><span t-field="line.product_id.default_code"/></td>
                                <td><span t-field="line.name"/></td>
                                <td><span t-field="line.product_id.description_pickingin"/></td>
                                <td class="text-end text-nowrap"><span t-field="line.product_uom_qty"/> <span t-field="line.product_uom_id"/></td>
                            </tr>
                            <tr t-else="">
                                <td><span t-field="line.name"/></td>
                                <td class="text-end text-nowrap"><span t-field="line.product_uom_qty"/> <span t-field="line.product_uom_id"/></td>
                                <td class="text-end"><span t-field="line.price_unit"/></td>
                                <td t-if="display_discount" class="text-end"><span t-field="line.discount"/></td>
                                <td class="text-end"><t t-out="', '.join(line.tax_ids.mapped(lambda t: t.invoice_label or t.name))"/></td>
                                <td class="text-end"><span t-field="line.price_subtotal" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/></td>
                            </tr>
                        </t>
                    </tbody>
                </table>

                <!-- Totals -->
                <table t-if="not work_order" class="o_ignore_layout_styling v-avoid" style="margin-top: 8px;">
                    <tr>
                        <td style="width: 60%;"/>
                        <td style="width: 40%;">
                            <t t-set="tax_totals" t-value="doc.tax_totals"/>
                            <table class="o_ignore_layout_styling v-totals">
                                <t t-foreach="tax_totals['subtotals']" t-as="subtotal">
                                    <tr>
                                        <td><t t-out="subtotal['name']"/></td>
                                        <td class="text-end"><t t-out="subtotal['base_amount_currency']" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/></td>
                                    </tr>
                                    <tr t-foreach="subtotal['tax_groups']" t-as="tax_group">
                                        <td><t t-out="tax_group['group_name']"/></td>
                                        <td class="text-end"><t t-out="tax_group['tax_amount_currency']" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/></td>
                                    </tr>
                                </t>
                                <tr class="v-grand" t-attf-style="background: {{ accent }};">
                                    <td>Total</td>
                                    <td class="text-end"><t t-out="tax_totals['total_amount_currency']" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/></td>
                                </tr>
                            </table>
                            <div class="text-end text-muted mt-1" style="font-size: 9px;">Moneda: <span t-field="doc.currency_id.name"/></div>
                        </td>
                    </tr>
                </table>

                <!-- Services -->
                <t t-if="show_services">
                    <t t-foreach="[('Alcance de nuestro servicio', doc.x_studio_alcance_de_nuestro_servicio), ('Requerimientos preliminares', doc.x_studio_requerimientos_preliminares), ('Requerimientos durante la ejecución', doc.x_studio_requerimientos_durante_la_ejecucin), ('Condiciones comerciales', doc.x_studio_condiciones_comerciales)]" t-as="section">
                        <div t-if="section[1]" class="v-avoid">
                            <div class="v-section-title" t-attf-style="border-color: {{ accent }}; color: {{ accent }};"><t t-out="section[0]"/></div>
                            <div class="v-text v-pre"><t t-out="section[1]"/></div>
                        </div>
                    </t>
                </t>

                <!-- Delivery data (sale orders) -->
                <div t-if="not quote" class="v-avoid">
                    <div class="v-section-title" t-attf-style="border-color: {{ accent }}; color: {{ accent }};">Datos de la entrega</div>
                    <table class="o_ignore_layout_styling v-info">
                        <tr>
                            <td class="v-k v-narrow">Requerimientos para la entrega</td>
                            <td><t t-out="doc.x_studio_requerimientos_para_la_entrega or '—'"/></td>
                        </tr>
                        <tr>
                            <td class="v-k">Método de entrega</td>
                            <td><t t-out="doc.carrier_id.name or '—'"/></td>
                        </tr>
                    </table>
                </div>

                <!-- Terms and conditions -->
                <div t-if="quote and not is_html_empty(doc.note)" class="v-notes mt-3" t-attf-style="border-color: {{ accent }};">
                    <span t-field="doc.note"/>
                </div>

                <p t-if="doc.fiscal_position_id and doc.fiscal_position_id.sudo().note" class="v-text mt-2">
                    <strong>Observación de la posición fiscal:</strong>
                    <span t-field="doc.fiscal_position_id.sudo().note"/>
                </p>

                <!-- Customer signature (portal) -->
                <div t-if="doc.signature" class="v-avoid mt-3 text-end">
                    <div class="v-label">Firma del cliente</div>
                    <img t-att-src="image_data_uri(doc.signature)" style="max-height: 3cm; max-width: 7cm;"/>
                    <div t-field="doc.signed_by"/>
                </div>

                <!-- Salesperson card + form code, kept together -->
                <div class="v-avoid">
                    <div t-if="quote and not is_html_empty(doc.user_id.signature)" class="v-seller">
                        <span t-field="doc.user_id.signature"/>
                    </div>
                    <div t-if="revision" class="v-revision"><t t-out="revision"/></div>
                </div>
            </div>
        </t>
    </template>
</odoo>
